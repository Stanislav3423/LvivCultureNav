# Порт HTTP-сервера
PORT=3000
# Шлях до файлу SQLite (створюється автоматично)
DB_FILE=server/data/lviv.db
# Ключ адміністратора для /admin (заголовок X-Admin-Key)
ADMIN_KEY=change-me
# Ключі партнерів для POST /api/partners/import: partnerId:key через кому
PARTNER_KEYS=opera:opera-secret,pinsel-museum:pinsel-secret
# Пішохідна маршрутизація OSRM (FOSSGIS, безкоштовно, без ключа, ≤ 1 запит/с)
OSRM_URL=https://routing.openstreetmap.de/routed-foot
# Ідентифікація застосунку для OSRM (вимога політики використання)
OSRM_USER_AGENT=LvivCultureNav/0.1 (university lab project)
